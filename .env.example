# Documentation only: not automatically loaded. Never commit actual values.
# Local quick start uses compass.py and an external state directory.
# For a private HTTPS deployment, use reviewed proxy configuration and a
# generated secret stored outside the source tree. See docs/deployment.md.
RADAR_DEBUG=0
DJANGO_ALLOWED_HOSTS=compass.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://compass.example.invalid
# DJANGO_SECRET_KEY=<GENERATE_AND_STORE_PRIVATELY>
# COMPASS_DATA_DIR=<ABSOLUTE_PRIVATE_STATE_DIRECTORY>
